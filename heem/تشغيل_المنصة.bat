@echo off
chcp 65001 >nul
title منصة أبناء حلفاية الملوك

echo ========================================================
echo        منصة أبناء حلفاية الملوك - التشغيل المباشر
echo ========================================================
echo.
echo [1/2] التحقق من السيرفر وقاعدة البيانات...

:: فحص ما إذا كان السيرفر يعمل مسبقاً
netstat -ano | findstr ":3000 " >nul
if %errorlevel% equ 0 (
    echo السيرفر وقاعدة البيانات يعملان بنجاح.
) else (
    echo جاري تشغيل خادم المنصة المحلي...
    start "سيرفر حلفاية الملوك" node server.js
    timeout /t 2 /nobreak >nul
)

echo [2/2] جاري فتح الموقع في متصفحك تلقائياً...
start http://localhost:3000/index.html

echo.
echo ✅ تم فتح المنصة بنجاح! يمكنك الآن استخدام الموقع مباشرة.
echo ========================================================
